{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mavis-brain-sync-local",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "mavis-brain-sync-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "mavis-brain-sync-local-private" }]
}
